{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gschmidtke/TIVERIT-BIM-STANDARDS/schemas/workflow.schema.json",
  "title": "TIVERIT BIM Workflow",
  "allOf": [
    {"$ref": "./base-object.schema.json"},
    {
      "type": "object",
      "properties": {
        "type": {"const": "workflow"},
        "trigger": {"type": ["string", "object"]},
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "action"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1},
              "actor_role": {"type": "string"},
              "inputs": {"type": "array", "items": {"type": "string"}},
              "outputs": {"type": "array", "items": {"type": "string"}},
              "verification": {"type": "object"}
            },
            "additionalProperties": true
          }
        },
        "process": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action"],
            "properties": {
              "step": {"type": ["integer", "string"]},
              "action": {"type": "string", "minLength": 1},
              "rule": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "assembly_process": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action"],
            "properties": {
              "step": {"type": ["integer", "string"]},
              "action": {"type": "string", "minLength": 1},
              "rule": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "question_catalog": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["question_id", "topic", "target", "ask_when", "output_section"],
            "properties": {
              "question_id": {"type": "string", "minLength": 1},
              "topic": {"type": "string", "minLength": 1},
              "target": {"type": "string", "minLength": 1},
              "ask_when": {"type": "string", "minLength": 1},
              "output_section": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "anyOf": [
        {"required": ["steps"]},
        {"required": ["process"]},
        {"required": ["assembly_process"]},
        {"required": ["question_catalog"]}
      ],
      "additionalProperties": true
    }
  ]
}
