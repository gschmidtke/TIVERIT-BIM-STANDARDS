{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gschmidtke/TIVERIT-BIM-STANDARDS/schemas/instruction.schema.json",
  "title": "TIVERIT BIM Instruction",
  "type": "object",
  "required": [
    "$schema",
    "id",
    "type",
    "title",
    "status",
    "authority",
    "layer",
    "modules",
    "purpose",
    "preconditions",
    "steps",
    "outputs",
    "evidence",
    "provenance"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^TIVERIT-[A-Z0-9-]+$"},
    "legacy_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "type": {"const": "instruction"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["migration_candidate", "draft", "active", "deprecated", "historical", "superseded"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "effective_date": {"type": ["string", "null"], "format": "date"},
    "authority": {"const": "instructional"},
    "layer": {"const": "L6"},
    "modules": {
      "type": "array",
      "items": {"type": "string", "pattern": "^S[1-9]$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "purpose": {"type": "string", "minLength": 1},
    "applies_to": {"type": "object"},
    "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "actions", "validation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string"},
          "preconditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "validation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "failure_modes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "automation_readiness": {"type": "string", "enum": ["MANUAL", "ASSISTED", "AUTOMATABLE"]}
        },
        "additionalProperties": true
      }
    },
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "relationships": {"type": "object", "additionalProperties": true},
    "future_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source_candidates": {"type": "object"},
    "governance_notes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "provenance": {
      "type": "object",
      "required": ["source_system", "page_id"],
      "properties": {
        "source_system": {"type": "string"},
        "space": {"type": "string"},
        "page_id": {"type": "string"},
        "source_version": {"type": ["integer", "string"]},
        "source_title": {"type": "string"},
        "source_url": {"type": "string"},
        "migration_note": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
      "then": {
        "required": ["version", "effective_date"],
        "properties": {"effective_date": {"type": "string", "format": "date"}}
      }
    }
  ],
  "additionalProperties": false
}
