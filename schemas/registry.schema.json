{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gschmidtke/TIVERIT-BIM-STANDARDS/schemas/registry.schema.json",
  "title": "TIVERIT BIM Registry",
  "allOf": [
    {"$ref": "./base-object.schema.json"},
    {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "type": {"const": "registry"},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "status": {"type": "string"},
              "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  ]
}
