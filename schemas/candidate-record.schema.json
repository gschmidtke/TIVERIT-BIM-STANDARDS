{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gschmidtke/TIVERIT-BIM-STANDARDS/schemas/candidate-record.schema.json",
  "title": "TIVERIT Standards Candidate Record",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "candidate_state",
    "candidate_class",
    "priority",
    "promotion_readiness",
    "source",
    "routing",
    "unresolved"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"const": "candidate_record"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "candidate_state": {
      "enum": [
        "captured",
        "classified",
        "evidence_required",
        "under_review",
        "standard_ready",
        "approved",
        "project_configuration",
        "tool_configuration",
        "evidence_only",
        "superseded",
        "rejected",
        "held_unresolved"
      ]
    },
    "candidate_class": {
      "enum": [
        "external_normative",
        "enterprise_governance",
        "project_governance_configuration",
        "tool_implementation_configuration",
        "observation_evidence"
      ]
    },
    "claimed_authority": {
      "type": "object",
      "properties": {
        "authority_rank": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2", "D1", "D2", "E1"]},
        "authority_basis": {"type": "string"},
        "verified": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "importance": {
      "type": "object",
      "required": ["scope", "impact", "dependency_reach", "urgency"],
      "properties": {
        "scope": {"enum": ["systemic", "enterprise", "multi_project", "project", "discipline", "tool_local"]},
        "impact": {"enum": ["critical", "high", "moderate", "low"]},
        "dependency_reach": {"enum": ["systemic", "broad", "bounded", "local"]},
        "urgency": {"enum": ["immediate", "high", "normal", "deferred"]},
        "rationale": {"type": "string"}
      },
      "additionalProperties": true
    },
    "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
    "promotion_readiness": {
      "enum": [
        "not_assessed",
        "insufficient_evidence",
        "conflicting_evidence",
        "needs_authority_verification",
        "needs_scope_resolution",
        "needs_reference_mapping",
        "ready_for_curator_review",
        "ready_for_owner_decision",
        "not_for_enterprise_standard"
      ]
    },
    "standards_eligibility": {
      "enum": [
        "potential_standard",
        "potential_workflow",
        "potential_instruction",
        "potential_registry_or_configuration",
        "project_only",
        "tool_only",
        "evidence_only",
        "undetermined"
      ]
    },
    "source": {
      "type": "object",
      "required": ["source_system", "source_reference"],
      "properties": {
        "source_system": {"type": "string"},
        "source_reference": {"type": "string"},
        "source_title": {"type": "string"},
        "source_version": {"type": ["string", "integer"]},
        "source_date": {"type": "string"},
        "source_authority_status": {"type": "string"}
      },
      "additionalProperties": true
    },
    "evaluated_against": {"type": "string"},
    "affected_modules": {
      "type": "array",
      "items": {"type": "string", "pattern": "^S[1-9]$"},
      "uniqueItems": true
    },
    "routing": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": {"enum": ["STANDARDS", "BEP", "PROJECT_CONFIGURATION", "TOOL_CONFIGURATION", "ARPL", "USG", "EVIDENCE_LEDGER", "HOLD"]},
        "reason": {"type": "string"},
        "owner_or_role": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "reference"],
        "properties": {
          "kind": {"type": "string"},
          "reference": {"type": "string"},
          "supports": {"type": "string"},
          "authority_status": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "blocking"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "blocking": {"type": "boolean"},
          "needed_evidence": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "curator_decision": {
      "type": ["object", "null"],
      "properties": {
        "disposition": {"enum": ["promote", "partially_promote", "route_configuration", "retain_evidence", "hold", "reject", "supersede"]},
        "decision_basis": {"type": "string"},
        "target_objects": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
