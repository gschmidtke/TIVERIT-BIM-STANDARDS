{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gschmidtke/TIVERIT-BIM-STANDARDS/schemas/executable-test.schema.json",
  "title": "TIVERIT Executable Test Specification",
  "type": "object",
  "required": [
    "$schema",
    "id",
    "type",
    "title",
    "status",
    "system_role",
    "modules",
    "ats_id",
    "implementation_binding",
    "implementation_state",
    "input_contract",
    "execution_contract",
    "evidence_output_contract",
    "result_mapping",
    "provenance"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^ETS-[A-Z0-9-]+$"},
    "type": {"const": "executable_test"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["migration_candidate", "draft", "active", "deprecated", "historical", "superseded"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "effective_date": {"type": ["string", "null"], "format": "date"},
    "system_role": {"const": "conformance"},
    "modules": {
      "type": "array",
      "items": {"type": "string", "pattern": "^S[1-9]$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "ats_id": {"type": "string", "pattern": "^ATS-[A-Z0-9-]+$"},
    "implementation_binding": {
      "type": "object",
      "required": ["platform", "implementation_class"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "executor": {"type": "string"},
        "implementation_class": {"type": "string", "enum": ["api_checker", "model_checker", "registry_checker", "file_checker", "hybrid"]},
        "supported_versions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "callable_reference": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "implementation_state": {"type": "string", "enum": ["specified_not_implemented", "implemented_unverified", "verified", "deprecated"]},
    "input_contract": {"type": "object", "minProperties": 1},
    "execution_contract": {"type": "object", "minProperties": 1},
    "evidence_output_contract": {"type": "object", "minProperties": 1},
    "result_mapping": {
      "type": "object",
      "required": ["pass", "fail", "indeterminate"],
      "properties": {
        "pass": {"type": "string", "minLength": 1},
        "fail": {"type": "string", "minLength": 1},
        "not_applicable": {"type": "string"},
        "indeterminate": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_system", "derived_from"],
      "properties": {
        "source_system": {"type": "string"},
        "derived_from": {"type": "string", "pattern": "^ATS-[A-Z0-9-]+$"},
        "migration_note": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
      "then": {
        "required": ["version", "effective_date"],
        "properties": {"effective_date": {"type": "string", "format": "date"}}
      }
    }
  ],
  "additionalProperties": false
}
