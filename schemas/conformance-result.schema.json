{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gschmidtke/TIVERIT-BIM-STANDARDS/schemas/conformance-result.schema.json",
  "title": "TIVERIT Conformance Result",
  "type": "object",
  "required": [
    "requirement_id",
    "ats_id",
    "tested_subject_id",
    "observation_timestamp",
    "result",
    "observations",
    "implementation"
  ],
  "properties": {
    "requirement_id": {"type": "string", "minLength": 1},
    "ats_id": {"type": "string", "pattern": "^ATS-[A-Z0-9-]+$"},
    "ets_id": {"type": ["string", "null"], "pattern": "^ETS-[A-Z0-9-]+$"},
    "tested_subject_id": {"type": "string", "minLength": 1},
    "observation_timestamp": {"type": "string", "format": "date-time"},
    "result": {"type": "string", "enum": ["pass", "fail", "not_applicable", "indeterminate"]},
    "observations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "implementation": {
      "type": "object",
      "required": ["name", "version_or_build"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version_or_build": {"type": "string", "minLength": 1},
        "platform": {"type": "string"}
      },
      "additionalProperties": true
    },
    "evidence_artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
